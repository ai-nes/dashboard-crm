# Base URL of the Frappe CRM backend that owns authentication and data.
# Dev default assumes the CRM container is published on port 8000.
NEXT_PUBLIC_FRAPPE_URL=http://localhost:8000

# Public origin of this dashboard, used as the OAuth return target.
# Must match CRM_GOOGLE_OAUTH_DASHBOARD_URL configured on the Frappe side.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-side Next.js proxy target for the new CRM backend's auth routes.
# Keep this private; do not rename it with the NEXT_PUBLIC_ prefix.
CRM_BACKEND_INTERNAL_URL=http://127.0.0.1:3001

# CRM Chatbot origin. The chatbot repo runs on port 5173 by default.
NEXT_PUBLIC_CRM_CHATBOT_URL=http://localhost:5173

# Remote STT Bridge. Keep the secret server-only; never prefix it with NEXT_PUBLIC_.
STT_BASE_URL=https://stt.faip.pro
# Local development only; keep this disabled/unset in production until auth is enforced at the proxy.
STT_PROXY_ENABLED=true
# STT_API_SECRET=

# Student/School 360 analysis runs are sent through the Frappe BFF.
# Frappe owns the server-only crm-agents URL and delegated credentials.
