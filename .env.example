# Base URL of the Frappe CRM backend that owns authentication and data.
# Dev default assumes the CRM container is published on port 8001.
NEXT_PUBLIC_FRAPPE_URL=http://localhost:8001

# Public origin of this dashboard, used as the OAuth return target.
# Must match CRM_GOOGLE_OAUTH_DASHBOARD_URL configured on the Frappe side.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# CRM Chatbot origin. The chatbot repo runs on port 5173 by default.
NEXT_PUBLIC_CRM_CHATBOT_URL=http://localhost:5173
